# Copy of settings used by app/config.py (all optional in Step 1)
ANTHROPIC_API_KEY=
DB_PATH=security.db
QUEUE_MAXSIZE=1000
TRAFFIC_MIN_EPS=5
TRAFFIC_MAX_EPS=20
PRINT_EVENTS=true

# --- Step 2: detection ---
FAILED_LOGIN_THRESHOLD=5
FAILED_LOGIN_WINDOW_S=120
TRANSFER_MULTIPLIER=10
TRANSFER_MIN_BYTES=10000000
DEFAULT_BASELINE_BYTES=50000
BASELINE_MIN_SAMPLES=20
ALERT_COOLDOWN_S=60
# --- Extra detection rules ---
IMPOSSIBLE_TRAVEL_WINDOW_S=3600
SPRAY_MIN_USERS=5
SPRAY_WINDOW_S=120
# Off-hours login is OFF by default (demo timestamps use the real clock, it would fire at random). Server local time.
OFF_HOURS_ENABLED=false
BUSINESS_HOURS_START=9
BUSINESS_HOURS_END=18
BUSINESS_DAYS=0,1,2,3,4
CRYPTOMINER_WINDOW_S=120
# CRYPTOMINER_IGNORE_PROCESSES=sh,bash,python,node,git   (comma list; a sensible default is built in)
# --- Step 2: attack injector (1.0 = realistic delays, 0.2 = 5x faster) ---
ATTACK_DELAY_SCALE=1.0
# --- Step 3: correlation ---
CORRELATION_WINDOW_S=600
CORRELATION_KEYS=user,ip

# --- Step 4: investigation agent ---
ANTHROPIC_MODEL=claude-sonnet-5-5
AGENT_DEBOUNCE_S=30
AGENT_TIMEOUT_S=90
AGENT_MAX_TURNS=8
AGENT_MAX_TOKENS=4096
# --- Free option: Google Gemini (leave ANTHROPIC_API_KEY empty and fill LLM_API_KEY; key from aistudio.google.com) ---
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-2.5-flash
LLM_NAME=gemini
# --- Step 5: actions that may run without human approval (only when the agent says true_positive) ---
AUTO_ACTIONS=open_ticket,block_ip,revoke_sessions

# --- Step 2: cloud ingestion ---
INGEST_MAX_RECORDS=5000

# --- Analyst feedback / stats ---
FEEDBACK_SUPPRESS_S=86400   # a false_positive decision mutes its (alert type, entity) pairs for this long
STATS_MAX_KEYS=5000         # max distinct source IPs / countries tracked for GET /stats
